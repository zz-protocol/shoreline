# 复制为 .env 后按需填写（docker compose 会读取）。
# ICP 数据源（未配置 ICP_API_URL 时 ICP 扩展自动关闭）
# ICP_PROVIDER: generic（默认，通用 records 格式）| icp_yanzhenma（自建 zz-protocol/icp_yanzhenma 服务）
ICP_PROVIDER=
# icp_yanzhenma 时填服务根地址，如 http://icp:8000（请求 <URL>/query?domain=...）
ICP_API_URL=
# 可选：有值时请求带 Authorization: Bearer <key>
ICP_API_KEY=

# 定时调度（Go duration；0/off 关闭）
SCHEDULE_PASSIVE=6h
SCHEDULE_ACTIVE=24h
