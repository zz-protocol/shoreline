# 复制为 .env 后按需填写（docker compose 会读取）。勿把 .env 提交进仓库。

# 首次启动必填：用它登录 Web / 调 API，再在「API Key」页创建正式 token
API_BOOTSTRAP_TOKEN=change-me-to-a-long-random-string

# ICP 数据源（未配置 ICP_API_URL 时 ICP 扩展自动关闭）
# ICP_PROVIDER: generic（默认）| icp_yanzhenma（自建 https://github.com/zz-protocol/icp_yanzhenma）
ICP_PROVIDER=
ICP_API_URL=
ICP_API_KEY=

# 定时调度（Go duration；0 或 off 关闭）
SCHEDULE_PASSIVE=6h
SCHEDULE_ACTIVE=24h
SCHEDULE_ALIVE=24h

# 可选：证书透明度流。自建：ws://certstream:8080/ 并加 --profile certstream
# 或指向公共服务，例如 wss://certstream.calidog.io/
CERTSTREAM_URL=

# 可选测绘 key（空则跳过该源）
# FOFA_KEY=
# QUAKE_KEY=
# HUNTER_KEY=
